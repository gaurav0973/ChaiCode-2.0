{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,

    // output settings
    "rootDir": "./src",
    "outDir": "./dist",

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitAny": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false, // function ke andar uused variables ko error nahi dega => true karke rakhna cahiye
    "noUnusedParameters": false, // function ke parameters ko error nahi dega agar wo unused hai => true karke rakhna cahiye
    "noPropertyAccessFromIndexSignature": false
  }
}
